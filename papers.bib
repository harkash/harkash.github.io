%                                 (no preview -> a tile showing the shorthand)
%   selected  = {true}            show under the "Selected" tab
%   topic     = {ssl, multimodal} research theme(s), for the filter buttons:
%                                 ssl = Self-supervised learning
%                                 multimodal = Sensors & language
%   tldr      = {One sentence.}   short summary under the authors
%   doi       = {10.1145/...}     main paper link (or html = {https://...})
%   pdf       = {https://...}     or a local file, e.g. {assets/pdf/x.pdf}
%   arxiv     = {2408.12023}      arXiv id
%   code      = {https://github.com/...}
%   website   = {https://...}     project page
%   blog      = {projects/...}    blog post / write-up (adds a "Blog" button)
%   video, slides, poster = {https://...}
%   award     = {Best Paper Award}
%   abstract  = {...}             adds an "Abstract" button
%
% Your name is bolded wherever it is wrapped in \textbf{...} (as in your CV),
% or when it matches CONFIG.self in assets/js/publications.js.
%
% Order: years are shown newest first automatically; within a year, papers
% appear in the order they are listed here.
